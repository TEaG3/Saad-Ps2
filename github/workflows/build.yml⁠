package com.saad.ps2manager

import android.app.Activity
import android.content.Intent
import android.net.Uri
import android.os.Bundle
import android.webkit.JavascriptInterface
import android.webkit.WebView
import android.webkit.WebViewClient
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity
import androidx.documentfile.provider.DocumentFile
import org.json.JSONArray
import org.json.JSONObject
import java.io.InputStream
import java.net.HttpURLConnection
import java.net.URL
import java.nio.charset.Charset
import java.util.regex.Pattern
import kotlin.concurrent.thread

class MainActivity : AppCompatActivity() {

    private lateinit var webView: WebView
    private var usbRootDir: DocumentFile? = null

    private val folderPickerLauncher = registerForActivityResult(
        ActivityResultContracts.StartActivityForResult()
    ) { result ->
        if (result.resultCode == Activity.RESULT_OK) {
            result.data?.data?.let { uri ->
                contentResolver.takePersistableUriPermission(
                    uri,
                    Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION
                )
                usbRootDir = DocumentFile.fromTreeUri(this, uri)
                scanUsbDriveInBackground()
            }
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        webView = WebView(this).apply {
            settings.javaScriptEnabled = true
            settings.domStorageEnabled = true
            webViewClient = WebViewClient()
            addJavascriptInterface(AndroidUsbBridge(), "AndroidUSB")
            loadUrl("file:///android_asset/index.html")
        }
        setContentView(webView)
    }

    inner class AndroidUsbBridge {
        @JavascriptInterface
        fun pickUsbFolder() {
            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT_TREE)
            folderPickerLauncher.launch(intent)
        }

        @JavascriptInterface
        fun downloadAndSaveCover(gameId: String) {
            thread {
                val success = fetchAndWriteArtwork(gameId)
                runOnUiThread {
                    webView.evaluateJavascript("if(window.onCoverSaved) onCoverSaved('$gameId', $success);", null)
                }
            }
        }
    }

    private fun scanUsbDriveInBackground() {
        runOnUiThread {
            webView.evaluateJavascript("if(window.onScanStarted) onScanStarted();", null)
        }

        thread {
            val root = usbRootDir ?: return@thread
            val gamesArray = JSONArray()

            val existingArt = root.findFile("ART")?.listFiles()?.mapNotNull { it.name?.uppercase() }?.toSet() ?: emptySet()
            val existingIcons = root.findFile("ICONS")?.listFiles()?.mapNotNull { it.name?.uppercase() }?.toSet() ?: emptySet()

            listOf("DVD", "CD").forEach { folderName ->
                root.findFile(folderName)?.listFiles()?.forEach { file ->
                    val name = file.name ?: ""
                    if (file.isFile && name.lowercase().endsWith(".iso")) {
                        val gameId = extractGameIdFromIso(file.uri, name)
                        if (gameId != null) {
                            val cleanTitle = name.replace(Regex("(?i)\\.iso$"), "")
                                .replace(Regex("^[A-Z]{4}[_-]\\d{3}\\.\\d{2}\\."), "")
                            val obj = JSONObject().apply {
                                put("title", cleanTitle)
                                put("gameId", gameId)
                                put("format", "ISO")
                                put("hasCover", existingArt.contains("${gameId}_COV.JPG") || existingArt.contains("$gameId.JPG"))
                                put("hasIcon", existingIcons.contains("${gameId}_ICO.PNG"))
                            }
                            gamesArray.put(obj)
                        }
                    }
                }
            }

            val jsonOutput = gamesArray.toString()
            runOnUiThread {
                webView.evaluateJavascript("if(window.onGamesScanned) onGamesScanned($jsonOutput);", null)
            }
        }
    }

    private fun extractGameIdFromIso(uri: Uri, fileName: String): String? {
        try {
            contentResolver.openInputStream(uri)?.use { stream ->
                val buffer = ByteArray(2 * 1024 * 1024)
                val bytesRead = stream.read(buffer)
                if (bytesRead > 0) {
                    val content = String(buffer, 0, bytesRead, Charset.forName("US-ASCII"))
                    val matcher = Pattern.compile("([S|P|L][L|C|B][U|E|P|K|A|J][S|D|M|X|P][_\\-]\\d{3}\\.\\d{2})", Pattern.CASE_INSENSITIVE).matcher(content)
                    if (matcher.find()) {
                        return matcher.group(1)?.uppercase()?.replace('-', '_')
                    }
                }
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
        val nameMatcher = Pattern.compile("([A-Z]{4}[_\\-]\\d{3}\\.\\d{2})", Pattern.CASE_INSENSITIVE).matcher(fileName)
        return if (nameMatcher.find()) nameMatcher.group(1)?.uppercase()?.replace('-', '_') else null
    }

    private fun fetchAndWriteArtwork(gameId: String): Boolean {
        val root = usbRootDir ?: return false
        val dashId = gameId.replace('_', '-')
        val urls = listOf(
            "https://raw.githubusercontent.com/xlenore/ps2-covers/main/covers/default/$dashId.jpg",
            "https://art.gametdb.com/ps2/cover/US/$dashId.jpg"
        )

        var imageBytes: ByteArray? = null
        for (urlStr in urls) {
            try {
                val conn = (URL(urlStr).openConnection() as HttpURLConnection).apply {
                    connectTimeout = 7000
                    readTimeout = 7000
                }
                if (conn.responseCode == 200) {
                    imageBytes = conn.inputStream.use(InputStream::readBytes)
                    break
                }
            } catch (_: Exception) {}
        }

        if (imageBytes == null) return false

        return try {
            val artDir = root.findFile("ART") ?: root.createDirectory("ART") ?: return false
            val iconsDir = root.findFile("ICONS") ?: root.createDirectory("ICONS") ?: return false

            writeBytesToDir(artDir, "${gameId}_COV.jpg", "image/jpeg", imageBytes)
            writeBytesToDir(artDir, "$gameId.jpg", "image/jpeg", imageBytes)
            writeBytesToDir(iconsDir, "${gameId}_ICO.png", "image/png", imageBytes)
            true
        } catch (e: Exception) {
            false
        }
    }

    private fun writeBytesToDir(dir: DocumentFile, fileName: String, mime: String, data: ByteArray) {
        dir.findFile(fileName)?.delete()
        val newFile = dir.createFile(mime, fileName) ?: return
        contentResolver.openOutputStream(newFile.uri)?.use { it.write(data) }
    }
}
